{
"version": 2,
"builds": [
{
"src": "server/server.js",
"use": "@vercel/node"
},
{
"src": "client/package.json",
"use": "@vercel/static-build",
"config": {
"distDir": "dist"
}
}
],
"routes": [
{
"src": "/api/(.)",
"dest": "/server/server.js"
},
{
"src": "/assets/(.)",
"dest": "/client/assets/$1"
},
{
"src": "/(./.(js|css|svg|png|jpg|jpeg|gif|ico|json|txt|woff|woff2))",
"dest": "/client/$1"
},
{
"src": "/(.)",
"dest": "/client/index.html"
}
]
}